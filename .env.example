# Copy to .env.local. The web build on this machine reaches the API by its hostname;
# a phone on the LAN needs the dev box's IP (the API must accept it as a host).
# EXPO_PUBLIC_API_URL=http://10.0.0.210:8180/v2
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_FACEBOOK_APP_ID=
# FACEBOOK_CLIENT_TOKEN=
