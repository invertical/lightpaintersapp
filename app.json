{
  "expo": {
    "name": "LightPainters",
    "slug": "lightpainters",
    "owner": "lightpainters",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lightpainters",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.lightpainters.app",
      "icon": "./assets/expo.icon",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14162C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lightpainters.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14162C",
          "image": "./assets/images/logo.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "LightPainters uses your photos so you can add them to your gallery and feed posts.",
          "cameraPermission": "LightPainters uses the camera so you can photograph your light painting for a post."
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91a58b5e-f2a2-4894-8097-66e999dde3b2"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/91a58b5e-f2a2-4894-8097-66e999dde3b2"
    }
  }
}
